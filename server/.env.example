# Model package created by the desktop Train + Deploy action.
ANIMAL_MODEL=desktop/data/models/deployed_model.joblib
API_KEY=replace-with-a-long-random-value

# Alert policy. Leave ALERT_TARGET_LABEL empty to alert on any class.
CONFIDENCE_THRESHOLD=0.60
ALERT_TARGET_LABEL=Elephant

# SIM7600 SMS. Use COMx on Windows or /dev/ttyUSBx on Raspberry Pi.
SMS_ENABLED=0
SMS_PHONE=+00000000000
SMS_PORT=/dev/ttyUSB2
SMS_BAUD=115200

# ThingsBoard telemetry.
TB_ENABLED=0
TB_HOST=eu.thingsboard.cloud
TB_TOKEN=replace-with-device-access-token
TB_INTERVAL_SEC=10
